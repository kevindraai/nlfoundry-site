---
import anvilHeroDark from '../assets/brand/nl-anvil-hero-dark.svg?url';
import anvilHeroLight from '../assets/brand/nl-anvil-hero-light.svg?url';
---

<div class="forge-visual" aria-hidden="true">
  <img
    class="forge-visual__image forge-visual__image--dark"
    src={anvilHeroDark}
    width="443"
    height="366"
    alt=""
    loading="eager"
    decoding="async"
  />
  <img
    class="forge-visual__image forge-visual__image--light"
    src={anvilHeroLight}
    width="443"
    height="366"
    alt=""
    loading="eager"
    decoding="async"
  />
</div>
