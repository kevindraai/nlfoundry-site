---
import { getCollection } from 'astro:content';
import ContactForm from './ContactForm.astro';
import SiteFooter from './SiteFooter.astro';
import LatestWriting from './LatestWriting.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projects = (await getCollection('projects', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => (a.data.product === 'exitlane' ? 0 : 1) - (b.data.product === 'exitlane' ? 0 : 1));
const status = { active: 'Active development', 'in-development': 'In development', maintenance: 'Maintenance', archived: 'Archived' };
---
<div class="foundry-home">
  <section class="foundry-hero" aria-labelledby="_top">
    <div class="foundry-hero__copy">
      <p class="foundry-eyebrow">Independent design &amp; software studio</p>
      <h1 id="_top">Software,<br />carefully<br />made.</h1>
      <p class="foundry-hero__description">Open-source tools and digital products.<br class="wide-break" /> Built with care, for the people who use them.</p>
      <a class="foundry-button" href="#work">Explore our work <span aria-hidden="true">↗</span></a>
    </div>
    <img class="foundry-hero__image" src={`${base}/brand/foundry-die.webp`} alt="" width="1448" height="1086" fetchpriority="high" />
  </section>
  <section id="work" class="foundry-work" aria-labelledby="work-title">
    <h2 id="work-title" class="foundry-eyebrow">01 / Selected work</h2>
    <div class="foundry-projects">
      {projects.map(({ id, data }) => (
        <article class={`foundry-project foundry-project--${data.product}`}>
          <div class="foundry-project__heading">
            <h3>{data.product === 'exitlane' ? 'exitlane' : data.title}</h3>
            <p class="foundry-project__type">{data.deliveryModel === 'open-source' ? 'Open source' : 'Hosted product'}</p>
          </div>
          <a class="foundry-project__visual" href={`${base}/projects/${id.replace(/\.(md|mdx)$/u, '')}/`} aria-label={`Explore ${data.title}`}>
            <img src={`${base}/products/${data.product}/hero.svg`} width="960" height="600" alt="" loading="lazy" />
          </a>
          <p class="foundry-project__description">{data.description}</p>
          <div class="foundry-project__bottom">
            <a class="foundry-link" href={`${base}/projects/${id.replace(/\.(md|mdx)$/u, '')}/`}>Explore {data.product === 'exitlane' ? 'exitlane' : data.title} <span aria-hidden="true">↗</span></a>
            <span class="foundry-project__status">{status[data.status]}</span>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section id="studio" class="foundry-studio" aria-labelledby="studio-title">
    <p class="foundry-eyebrow">02 / The studio</p>
    <div class="foundry-studio__columns">
      <h2 id="studio-title">Personal by origin.<br />Practical by design.</h2>
      <div>
        <p>Foundry is where ideas take shape.</p>
        <p>A small, independent studio bringing design and engineering together. From open-source tools to products built around everyday work.</p>
        <div class="foundry-studio__links"><a class="foundry-link" href={`${base}/about/`}>Meet the studio <span aria-hidden="true">↗</span></a><a class="foundry-link" href={`${base}/engineering/`}>How we work <span aria-hidden="true">↗</span></a></div>
      </div>
    </div>
  </section>
  <section class="foundry-journal" aria-labelledby="journal-title">
    <h2 id="journal-title" class="foundry-eyebrow">03 / From the workbench</h2>
    <LatestWriting />
  </section>
  <section id="contact" class="foundry-contact" aria-label="Contact the studio"><ContactForm compact /></section>
  <SiteFooter />
</div>
