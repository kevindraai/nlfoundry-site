---
import DefaultHeader from '@astrojs/starlight/components/Header.astro';
import BrandLockup from './BrandLockup.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isHome = Astro.locals.starlightRoute.id === 'index' || Astro.url.pathname === `${base}/`;
---
{isHome ? (
  <div class="tp-header">
    <a href={`${base}/`} class="tp-header__brand" aria-label="Tuned.pixel home"><BrandLockup /></a>
    <nav class="tp-header__nav" aria-label="Hoofdnavigatie">
      <a href="#work">Werk</a><a href="#studio">Over Kevin</a><a href={`${base}/journal/`}>Notities</a>
      <a class="tp-button" href="#contact">Contact</a>
    </nav>
    <details class="tp-menu">
      <summary aria-label="Open menu">Menu <span aria-hidden="true">☰</span></summary>
      <nav aria-label="Mobiele navigatie">
        <a href="#work">Werk</a><a href="#studio">Over Kevin</a><a href={`${base}/journal/`}>Notities</a>
        <a href={`${base}/engineering/`}>Werkwijze</a><a href="#contact">Contact</a>
      </nav>
    </details>
  </div>
) : <DefaultHeader />}
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.tp-menu');
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { menu.open = false; }));
  menu?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') { menu.open = false; menu.querySelector('summary')?.focus(); }
  });
</script>
