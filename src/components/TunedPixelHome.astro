---
import { getCollection } from 'astro:content';
import ContactForm from './ContactForm.astro';
import SiteFooter from './SiteFooter.astro';
import LatestWriting from './LatestWriting.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projects = (await getCollection('projects', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => (a.data.product === 'clubpos' ? 0 : 1) - (b.data.product === 'clubpos' ? 0 : 1));
const status = { active: 'In ontwikkeling', 'in-development': 'In ontwikkeling', maintenance: 'Onderhoud', archived: 'Gearchiveerd' };
const summaries = {
  clubpos: { label: 'Aan de bar', title: 'Voor de mensen achter de bar.', text: 'Een kassasysteem voor clubs en verenigingen. Met ruimte voor openstaande rekeningen, leden en de drukte van een bardienst.' },
  exitlane: { label: 'Op je netwerk', title: 'Grip op het verkeer in je netwerk.', text: 'Een VPN-gateway voor je hele netwerk. Je kiest welk verkeer via welke verbinding loopt, op één centrale plek.' },
};
---
<div class="tp-home">
  <section class="tp-hero" aria-labelledby="_top">
    <p class="tp-eyebrow">Tuned.pixel · Ontwerp &amp; development</p>
    <h1 id="_top">Aandacht voor<br />hoe het werkt<span class="tp-period" aria-hidden="true"></span></h1>
    <div class="tp-hero-bottom">
      <p class="tp-hero__description">Ik ben Kevin. Ik ontwerp en bouw digitale producten.<br class="wide-break" /> Van een kassasysteem voor de vereniging tot gereedschap voor je netwerk.</p>
      <a class="tp-link" href="#work">Dit is waar ik aan werk <span aria-hidden="true">↓</span></a>
    </div>
  </section>
  <section id="work" class="tp-work" aria-labelledby="work-title">
    <div class="tp-section-heading"><h2 id="work-title">Eigen projecten</h2><p>ClubPOS en ExitLane zijn in ontwikkeling.</p></div>
    <div class="tp-projects">
      {projects.map(({ id, data }) => (
        <article class={`tp-project tp-project--${data.product}`}>
          <a class="tp-project__visual" href={`${base}/projects/${id.replace(/\.(md|mdx)$/u, '')}/`} aria-label={`Bekijk ${data.title}`}>
            <img src={`${base}/products/${data.product}/hero.svg`} width="960" height="600" alt="" loading="lazy" />
            <span class="tp-project-caption">{summaries[data.product].label}</span>
          </a>
          <div class="tp-project__heading"><h3>{data.title}</h3><span class="tp-project__status">{status[data.status]}</span></div>
          <p class="tp-project-title">{summaries[data.product].title}</p>
          <p class="tp-project__description">{summaries[data.product].text}</p>
          <a class="tp-link" href={`${base}/projects/${id.replace(/\.(md|mdx)$/u, '')}/`}>Meer over {data.title} <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>
  </section>
  <section id="studio" class="tp-studio" aria-labelledby="studio-title">
    <div class="tp-personal-mark" aria-hidden="true"><svg viewBox="0 0 40 40"><path fill="currentColor" d="M12 6H18V14H24V20H18V27Q18 30 22 30H24V36H21Q12 36 12 27V20H6V14H12Z M28 14H34V20H28Z" /></svg><span>Tuned.pixel / Kevin van der Draai</span></div>
    <div class="tp-personal-copy">
      <p class="tp-eyebrow">Wat ik doe</p>
      <h2 id="studio-title">Van idee naar<br />digitale dienst.</h2>
      <p>Ik ben Kevin van der Draai. Ik ontwerp en bouw websites, applicaties en andere digitale diensten. Daarbij werk ik aan wat je ziet én aan de techniek erachter.</p>
      <p>Heb je iets nieuws in gedachten, of een bestaande toepassing die beter kan? Ik denk met je mee over wat nodig is en werk het uit tot iets dat je kunt gebruiken.</p>
      <a class="tp-link" href={`${base}/about/`}>Meer over mij <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <section class="tp-journal" aria-labelledby="journal-title">
    <div class="tp-section-heading"><h2 id="journal-title">Notities</h2><p>Wat ik onderweg uitzoek en leer.</p></div>
    <LatestWriting />
  </section>
  <section id="contact" class="tp-contact" aria-label="Contact"><ContactForm compact /></section>
  <SiteFooter />
</div>
