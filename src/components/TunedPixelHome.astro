---
import { getCollection } from 'astro:content';
import ContactForm from './ContactForm.astro';
import SiteFooter from './SiteFooter.astro';
import LatestWriting from './LatestWriting.astro';
import TunedPixelHero from './TunedPixelHero.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projectHref = (id: string) => `${base}/projects/${id.replace(/\.(md|mdx)$/u, '')}/`;
const order = { clubsolution: 0, exitlane: 1 };
const projects = (await getCollection('projects', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => order[a.data.product] - order[b.data.product]);
const scale = {
  clubsolution: { label: 'Aan de bar', summary: 'Kassa wordt getest · meer modules volgen' },
  exitlane: { label: 'Op je netwerk', summary: 'VPN-gateway voor je hele netwerk · open source' },
};
const heroProjects = projects.map(({ id, data }) => ({ title: data.title, href: projectHref(id), ...scale[data.product] }));
const clubsolution = projects.find(({ data }) => data.product === 'clubsolution');
const others = projects.filter(({ data }) => data.product !== 'clubsolution');
const otherCopy = {
  exitlane: { status: 'Open source', text: 'Een VPN-gateway voor je hele netwerk. Je kiest op één plek welk verkeer via welke verbinding loopt.' },
};
const modules = [
  { name: 'ClubSolution Kassa', state: 'Wordt getest', now: true },
  { name: 'ClubSolution Basis', state: 'Volgt', now: false },
  { name: 'ClubSolution Boekhouden', state: 'Volgt', now: false },
];
---
<div class="tp-home">
  <TunedPixelHero projects={heroProjects} />

  <section id="studio" class="tp-about" aria-labelledby="studio-title">
    <div>
      <h2 class="tp-kicker" id="studio-title">Wat ik doe</h2>
      <blockquote class="tp-about__quote">Een duidelijke knop helpt weinig als de stap erna onlogisch is. En een goed systeem moet te begrijpen zijn <em>zonder handleiding naast je toetsenbord.</em></blockquote>
      <a class="tp-link" href={`${base}/about/`}>Meer over mij <span aria-hidden="true">↗</span></a>
    </div>
    <dl class="tp-about__sides">
      <div><dt>Ontwerp</dt><dd>Wat je ziet: schermen, bediening en de woorden erop.</dd></div>
      <div><dt>Development</dt><dd>Wat erachter zit: de techniek, de gegevens en wat er gebeurt als het misgaat.</dd></div>
      <div><dt>Samen</dt><dd>Eén aanspreekpunt, zodat keuzes over hoe het eruitziet en hoe het werkt tegelijk worden gemaakt.</dd></div>
    </dl>
  </section>

  <section id="work" class="tp-work" aria-labelledby="work-title">
    <div class="tp-work__head">
      <p class="tp-kicker">Eigen werk</p>
      <h2 id="work-title">Wat ik nu bouw.</h2>
    </div>
    {clubsolution && (
      <a class="tp-feature" href={projectHref(clubsolution.id)}>
        <div class="tp-feature__visual" aria-hidden="true">
          <img class="tp-feature__logo" src={`${base}/products/clubsolution/wordmark-light.svg`} width="928" height="192" alt="" />
          <img class="tp-feature__symbol" src={`${base}/products/clubsolution/icon.svg`} width="192" height="192" alt="" />
          <div class="tp-feature__bon">
            <div class="tp-feature__bon-head"><span>Bon op naam</span><span>21:20</span></div>
            <div class="tp-feature__bon-name">Jeroen V.</div>
            <div class="tp-feature__bon-row"><span>2× Koffie</span><span>€ 3,00</span></div>
            <div class="tp-feature__bon-row"><span>1× Tosti</span><span>€ 3,50</span></div>
            <div class="tp-feature__bon-row tp-feature__bon-total"><span>Totaal</span><span>€ 6,50</span></div>
          </div>
        </div>
        <div class="tp-feature__text">
          <span class="tp-status">Kassa wordt getest bij onze eigen club</span>
          <h3>{clubsolution.data.title}</h3>
          <p>Software voor verenigingen met een eigen bar, opgebouwd uit modules. Je begint met wat je nodig hebt en zet de rest aan wanneer jullie eraan toe zijn.</p>
          <ul class="tp-modules">
            {modules.map((module) => (
              <li class={module.now ? 'is-now' : undefined}><b>{module.name}</b><span>{module.state}</span></li>
            ))}
          </ul>
          <span class="tp-more">Meer over {clubsolution.data.title} <span aria-hidden="true">→</span></span>
        </div>
      </a>
    )}
    <div class="tp-others">
      {others.map(({ id, data }) => (
        <a class="tp-other" href={projectHref(id)}>
          <img src={`${base}/products/${data.product}/hero.svg`} width="960" height="600" alt="" loading="lazy" />
          <div>
            <span class="tp-status">{otherCopy[data.product as keyof typeof otherCopy]?.status}</span>
            <h3>{data.title}</h3>
            <p>{otherCopy[data.product as keyof typeof otherCopy]?.text ?? data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="tp-journal" aria-labelledby="journal-title">
    <div class="tp-section-heading"><h2 id="journal-title">Notities</h2><p>Wat ik onderweg uitzoek en leer.</p></div>
    <LatestWriting />
  </section>

  <section id="contact" class="tp-contact" aria-label="Contact">
    <ContactForm compact />
    <div class="tp-contact__mark" aria-hidden="true"><img src={`${base}/brand/tp-wordmark-ice.svg`} width="408" height="94" alt="" /></div>
  </section>
  <SiteFooter />
</div>
