---
import DefaultHeader from '@astrojs/starlight/components/Header.astro';
import BrandLockup from './BrandLockup.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isHome = Astro.locals.starlightRoute.id === 'index' || Astro.url.pathname === `${base}/`;
---
{isHome ? (
  <div class="foundry-header">
    <a href={`${base}/`} class="foundry-header__brand" aria-label="N/L Foundry home"><BrandLockup /></a>
    <nav class="foundry-header__nav" aria-label="Main navigation">
      <a href="#work">Work</a><a href="#studio">Studio</a><a href={`${base}/journal/`}>Journal</a>
      <a class="foundry-button" href="#contact">Get in touch</a>
    </nav>
    <details class="foundry-menu">
      <summary aria-label="Open navigation">Menu <span aria-hidden="true">☰</span></summary>
      <nav aria-label="Mobile navigation">
        <a href="#work">Work</a><a href="#studio">Studio</a><a href={`${base}/journal/`}>Journal</a>
        <a href={`${base}/engineering/`}>Engineering</a><a href="#contact">Get in touch</a>
      </nav>
    </details>
  </div>
) : <DefaultHeader />}
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.foundry-menu');
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { menu.open = false; }));
  menu?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') { menu.open = false; menu.querySelector('summary')?.focus(); }
  });
</script>
