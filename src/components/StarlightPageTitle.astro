---
const { starlightRoute } = Astro.locals;
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const isHomePage = starlightRoute.id === 'index' || Astro.url.pathname === basePath;
const pageTitleId = '_top';
---

{!isHomePage && <h1 id={pageTitleId}>{starlightRoute.entry.data.title}</h1>}
