---
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
const parseStalwartFormUrl = (value: string | undefined, variableName: string) => {
  const normalized = value?.trim();
  if (!normalized) return undefined;

  let url: URL;
  try {
    url = new URL(normalized);
  } catch {
    throw new Error(`${variableName} must be an absolute URL.`);
  }

  if (url.protocol !== 'https:') {
    throw new Error(`${variableName} must use HTTPS.`);
  }

  if (url.username || url.password) {
    throw new Error(`${variableName} must not contain credentials.`);
  }

  if (!url.pathname.endsWith('/form')) {
    throw new Error(`${variableName} must point to the Stalwart /form endpoint.`);
  }

  if (url.search || url.hash) {
    throw new Error(`${variableName} must not contain a query string or fragment.`);
  }

  return url.toString();
};

const parseEmail = (value: string | undefined) => {
  const normalized = value?.trim();
  if (!normalized) return undefined;
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/u.test(normalized)) {
    throw new Error('PUBLIC_CONTACT_EMAIL must be a valid email address.');
  }
  return normalized;
};

const formAction = parseStalwartFormUrl(
  import.meta.env.PUBLIC_CONTACT_FORM_ACTION,
  'PUBLIC_CONTACT_FORM_ACTION',
);
const contactEmail = parseEmail(import.meta.env.PUBLIC_CONTACT_EMAIL || 'info@tunedpixel.nl');
const privacyMessage = formAction
  ? 'Je bericht komt bij mij terecht. Ik gebruik je gegevens om je te antwoorden.'
  : 'Het formulier is tijdelijk niet beschikbaar. Hieronder vind je een andere manier om contact op te nemen.';
---

<section class="contact-panel" aria-labelledby="contact-form-title">
  <div class="contact-panel__intro">
    <p class="contact-panel__eyebrow">{compact ? 'Contact' : 'Een bericht aan Kevin'}</p>
    <h2 id="contact-form-title">{compact ? 'Wat ben je van plan?' : 'Vertel me waar je aan denkt.'}</h2>
    <p>
      Een vraag over een project, iets dat beter kan, of een idee waar je over wilt praten? Schrijf me gerust. Het hoeft nog geen uitgewerkt plan te zijn.
    </p>
    {contactEmail && (
      <p><a class="contact-panel__fallback" href={`mailto:${contactEmail}`}>Mail naar {contactEmail}</a></p>
    )}
    {!formAction && !contactEmail && (
      <p class="contact-panel__notice">
        Het formulier is tijdelijk niet beschikbaar. Je vindt me ook op
        <a href="https://github.com/kevindraai"> GitHub</a>.
      </p>
    )}
  </div>

  <form
    class="contact-form"
    action={formAction}
    method="post"
    enctype="application/x-www-form-urlencoded"
    accept-charset="UTF-8"
  >
    <fieldset class="contact-form__fields" disabled={!formAction}>
      <div class="contact-form__field">
        <label for="contact-name">Naam</label>
        <input id="contact-name" name="name" type="text" autocomplete="name" maxlength="120" required />
      </div>
      <div class="contact-form__field">
        <label for="contact-email">E-mailadres</label>
        <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required />
      </div>
      <div class="contact-form__field">
        <label for="contact-subject">Onderwerp</label>
        <input id="contact-subject" name="subject" type="text" maxlength="160" required />
      </div>
      <div class="contact-form__field">
        <label for="contact-message">Bericht</label>
        <textarea id="contact-message" name="message" rows="7" maxlength="5000" required></textarea>
      </div>
      <div class="contact-form__honeypot" aria-hidden="true">
        <label for="contact-company">Bedrijfswebsite</label>
        <input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <p id="contact-form-privacy" class="contact-form__privacy">
        {privacyMessage}
      </p>
      <button type="submit" aria-describedby="contact-form-privacy">
        {formAction ? 'Verstuur bericht' : 'Formulier niet beschikbaar'}
      </button>
    </fieldset>
  </form>
</section>
