---
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (href: string) => `${base}${href}`;
const entrySlug = (id: string) => id.replace(/\.(md|mdx)$/u, '');
const productAssets = {
  exitlane: `${base}/products/exitlane/badge.svg`,
  clubpos: `${base}/products/clubpos/badge.svg`,
};
const statusLabels = {
  active: 'Active development',
  'in-development': 'In development',
  maintenance: 'Maintenance',
  archived: 'Archived',
};
const deliveryLabels = {
  'open-source': 'Open source',
  'hosted-product': 'Hosted product',
};
const projects = (await getCollection('projects', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf());
---

<div class="project-grid">
  {projects.map((project) => (
    <article class={`project-card project-card--${project.data.product}`}>
      <div class="project-card__heading">
        <img class="project-card__icon" src={productAssets[project.data.product]} width="64" height="64" alt="" aria-hidden="true" />
        <div class="project-card__meta">
          <span>{deliveryLabels[project.data.deliveryModel]}</span>
          <span>{statusLabels[project.data.status]}</span>
        </div>
      </div>
      <h3>{project.data.title}</h3>
      <p>{project.data.description}</p>
      <p class="project-card__focus">{project.data.focus}</p>
      <a href={withBase(`/projects/${entrySlug(project.id)}/`)} aria-label={`Explore ${project.data.title}`}>
        Explore {project.data.title}<span aria-hidden="true"> →</span>
      </a>
    </article>
  ))}
</div>
