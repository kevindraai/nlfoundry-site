---
import { projects } from '../data/projects';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (href: string) => `${base}${href}`;
---

<div class="project-grid">
  {projects.map((project) => (
    <article class={`project-card project-card--${project.slug}`}>
      <div class="project-card__meta">
        <span>{project.deliveryModel}</span>
        <span>{project.status}</span>
      </div>
      <h3>{project.name}</h3>
      <p>{project.summary}</p>
      <p class="project-card__focus">{project.focus}</p>
      <a href={withBase(project.href)} aria-label={`Explore ${project.name}`}>
        Explore {project.name} →
      </a>
    </article>
  ))}
</div>
