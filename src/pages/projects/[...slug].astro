---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ProductHero from '../../components/ProductHero.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const statusLabels = {
  active: 'Active development',
  'in-development': 'In development',
  maintenance: 'Maintenance',
  archived: 'Archived',
};

export async function getStaticPaths() {
  const entrySlug = (id: string) => id.replace(/\.(md|mdx)$/u, '');
  const projects = await getCollection(
    'projects',
    ({ data }) => import.meta.env.DEV || !data.draft,
  );
  return projects.map((project) => ({
    params: { slug: entrySlug(project.id) },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
---

<StarlightPage
  frontmatter={{ title: project.data.title, description: project.data.description }}
  headings={headings}
>
  <ProductHero product={project.data.product} />
  <p class="content-meta">
    <span>{project.data.deliveryModel === 'open-source' ? 'Open source' : 'Hosted product'}</span>
    <span>{statusLabels[project.data.status]}</span>
    {project.data.draft && <strong>Draft preview</strong>}
  </p>
  <Content />
  {project.data.links.length > 0 && (
    <section class="project-links" aria-labelledby="project-links-title">
      <h2 id="project-links-title">Links</h2>
      <ul>
        {project.data.links.map((link) => (
          <li><a href={link.url} rel="noreferrer">{link.label}</a></li>
        ))}
      </ul>
    </section>
  )}
</StarlightPage>
