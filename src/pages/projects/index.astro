---
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (href: string) => `${base}${href}`;
const entrySlug = (id: string) => id.replace(/\.(md|mdx)$/u, '');
const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
---

<StarlightPage
  frontmatter={{
    title: 'Projecten',
    description: 'ClubPOS en ExitLane: de digitale producten waar ik aan werk.',
    template: 'splash',
    prev: false,
    next: false,
  }}
>
  <p class="page-intro">
    Dit zijn de producten waar ik aan werk. Op elke projectpagina lees je wat het doet en hoever het is.
  </p>
  <div class="collection-grid">
    {projects.map((project) => (
      <article class={`collection-card collection-card--${project.data.product}`}>
        <p class="collection-card__eyebrow">{project.data.deliveryModel.replace('-', ' ')}</p>
        <h2><a href={withBase(`/projects/${entrySlug(project.id)}/`)}>{project.data.title}</a></h2>
        <p>{project.data.description}</p>
        <ul class="tag-list" aria-label={`${project.data.title} tags`}>
          {project.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </article>
    ))}
  </div>
</StarlightPage>
