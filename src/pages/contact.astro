---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ContactForm from '../components/ContactForm.astro';
---

<StarlightPage
  frontmatter={{
    title: 'Contact N/L Foundry',
    description: 'Start a focused conversation about practical software, infrastructure or engineering work.',
    prev: false,
    next: false,
  }}
>
  <p class="page-intro">
    N/L Foundry works best on problems where software meets real operations, existing constraints
    and clear responsibility.
  </p>
  <ContactForm />

  <h2>Form delivery</h2>
  <p>
    This static site submits the form directly to a reviewed Stalwart endpoint. Delivery stays
    disabled when that public HTTPS endpoint is not configured, and the site still has no database,
    CMS, account requirement or tracking.
  </p>
</StarlightPage>
