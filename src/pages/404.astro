---
import '../styles/tokens.css';
import '../styles/foundry.css';

const base = import.meta.env.BASE_URL;
const home = base === '/' ? '/' : base.replace(/\/$/, '');
const favicon = `${base}favicon.svg`;
---

<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Pagina niet gevonden | Tuned.pixel</title>
    <link rel="icon" href={favicon} type="image/svg+xml" />
  <style>
      :root {
        color-scheme: light dark;
        font-family: var(--nl-font-display);
      }

      .skip {
        position: absolute;
        left: -9999px;
        top: 1rem;
      }

      .skip:focus {
        left: 1rem;
      }

      body {
        min-height: 100vh;
        margin: 0;
        display: grid;
        place-items: center;
        background: var(--nl-night);
        color: var(--nl-ice);
      }

      main {
        width: min(42rem, calc(100% - 3rem));
      }

      .mark {
        width: 5rem;
        height: 0.55rem;
        background: var(--nl-electric_blue);
        margin-bottom: 2rem;
      }

      .code {
        color: var(--nl-electric_blue);
        font-weight: 750;
        letter-spacing: 0.12em;
      }

      h1,
      p {
        max-width: 42rem;
        color: inherit;
      }

      h1 {
        margin: 0.6rem 0 1rem;
        font-size: clamp(2.6rem, 8vw, 5.4rem);
        line-height: 0.98;
        letter-spacing: -0.055em;
      }

      p {
        font-size: 1.12rem;
        line-height: 1.65;
      }

      a {
        display: inline-block;
        margin-top: 1.25rem;
        padding: 0.8rem 1.1rem;
        border: 1px solid var(--nl-electric_blue);
        border-radius: 0;
        color: var(--nl-night);
        background: var(--nl-electric_blue);
        text-decoration: none;
        font-weight: 700;
      }

      a:hover {
        background: var(--nl-ice);
      }

      a:focus-visible {
        outline: 3px solid var(--nl-electric_blue);
        outline-offset: 3px;
      }
  </style>
  </head>
  <body>
    <main>
      <a class="skip" href="#nf404-content">Naar de inhoud</a>
      <div class="mark"></div>
      <div class="code">404 / NIET GEVONDEN</div>
      <h1 id="nf404-content">Deze pagina is er niet.</h1>
      <p>Misschien is de pagina verplaatst, of staat er een foutje in de link. Via de homepage vind je de projecten en notities.</p>
      <a href={home}>Naar de homepage</a>
    </main>
  </body>
</html>
